# Скопируйте в .env перед первым запуском:  cp .env.example .env
# Файл .env в git не попадает (см. .gitignore)

# --- Администратор -----------------------------------------------------------
# ВАЖНО: задайте пароль ДО первого старта. Демоданные заливаются только в пустую
# базу, поэтому на уже созданной БД смена этой переменной ничего не изменит.
ADMIN_EMAIL=ney4s@tutorsite.local
ADMIN_PASSWORD=

# --- Подпись токенов ---------------------------------------------------------
# Минимум 32 символа. Сгенерировать:  openssl rand -base64 48
JWT_SECRET=

# --- База данных -------------------------------------------------------------
# Порт хоста для базы. Смените, если 5432 уже занят локальным постгресом
DB_PORT_HOST=5432
DB_NAME=tutorsite
DB_USER=tutor
DB_PASSWORD=

# --- Сеть --------------------------------------------------------------------
# Порт, на котором отдаётся сайт
WEB_PORT=3000

# Домены, которым разрешено ходить в API напрямую. В контейнерной сборке фронт
# обращается к API через собственный nginx, то есть с того же адреса, и CORS
# не задействуется. Заполняйте, только если дёргаете 8080 со стороны.
CORS_ORIGINS=http://localhost:3000
